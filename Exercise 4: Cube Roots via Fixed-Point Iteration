import matplotlib.pyplot as plt
import numpy as np


def fpi_cube_root(A, x0=1.0, tol=0.5e-8, max_iter=100):
    g = lambda x: (2 * x + A / (x**2)) / 3.0
    x = x0
    for steps in range(1, max_iter + 1):
        x_next = g(x)
        if abs(x_next - x) < tol:
            return x_next, steps
        x = x_next
    return x, max_iter


# Calculations
A_values = [2, 3, 5]
results = {}

print("--- EXERCISE 4 RESULTS ---")
for A in A_values:
    root, steps = fpi_cube_root(A, x0=1.0)
    results[A] = (root, steps)
    print(
        f"4({chr(96+A_values.index(A)+1)}) cbrt({A}): Initial Guess x0 = 1.0 | Root: {root:.8f} | Steps: {steps}"
    )

# Plotting
fig, axes = plt.subplots(1, 3, figsize=(15, 4.5))

for i, A in enumerate(A_values):
    root, steps = results[A]
    g = lambda x: (2 * x + A / (x**2)) / 3.0

    x = np.linspace(0.8, 2.2, 200)
    axes[i].plot(
        x, g(x), "b-", lw=2, label=f"$g(x) = \\frac{{2x + {A}/x^2}}{{3}}$"
    )
    axes[i].plot(x, x, "k--", alpha=0.7, label="$y = x$")
    axes[i].plot(
        root,
        root,
        "ro",
        markersize=7,
        label=f"$\sqrt[3]{{{A}}} \\approx {root:.8f}$",
    )
    axes[i].set_title(f"Exercise 4({chr(97+i)}) [A = {A}]", fontweight="bold")
    axes[i].set_xlabel("$x$")
    axes[i].set_ylabel("$g(x)$")
    axes[i].grid(True, ls=":", alpha=0.6)
    axes[i].legend()

plt.tight_layout()
plt.show()
