import matplotlib.pyplot as plt
import numpy as np


def bisection(f, a, b, tol=0.5e-8):
    if f(a) * f(b) >= 0:
        raise ValueError("Endpoints must have opposite signs.")
    while (b - a) / 2.0 > tol:
        c = (a + b) / 2.0
        if f(c) == 0:
            return c
        elif f(a) * f(c) < 0:
            b = c
        else:
            a = c
    return (a + b) / 2.0


# Define functions f(x) = 0
f2a = lambda x: x**5 + x - 1
f2b = lambda x: np.sin(x) - 6 * x - 5
f2c = lambda x: np.log(x) + x**2 - 3

# Solve roots
r2a = bisection(f2a, 0.0, 1.0)
r2b = bisection(f2b, -1.0, 0.0)
r2c = bisection(f2c, 1.0, 2.0)

print("--- EXERCISE 2 RESULTS ---")
print(f"2(a) x^5 + x = 1          -> Root: {r2a:.8f}")
print(f"2(b) sin(x) = 6x + 5      -> Root: {r2b:.8f}")
print(f"2(c) ln(x) + x^2 = 3      -> Root: {r2c:.8f}")

# Plotting
fig, axes = plt.subplots(1, 3, figsize=(15, 4.5))

# Plot 2(a)
x = np.linspace(0.0, 1.2, 200)
axes[0].plot(x, f2a(x), "b-", lw=2, label="$f(x) = x^5 + x - 1$")
axes[0].axhline(0, color="k", ls="--", lw=0.8)
axes[0].plot(r2a, 0, "ro", label=f"Root: {r2a:.8f}")
axes[0].set_title("Exercise 2(a)", fontweight="bold")
axes[0].grid(True, ls=":", alpha=0.6)
axes[0].legend()

# Plot 2(b)
x = np.linspace(-1.5, 0.5, 200)
axes[1].plot(x, f2b(x), "b-", lw=2, label="$f(x) = \sin(x) - 6x - 5$")
axes[1].axhline(0, color="k", ls="--", lw=0.8)
axes[1].plot(r2b, 0, "ro", label=f"Root: {r2b:.8f}")
axes[1].set_title("Exercise 2(b)", fontweight="bold")
axes[1].grid(True, ls=":", alpha=0.6)
axes[1].legend()

# Plot 2(c)
x = np.linspace(0.5, 2.5, 200)
axes[2].plot(x, f2c(x), "b-", lw=2, label="$f(x) = \ln(x) + x^2 - 3$")
axes[2].axhline(0, color="k", ls="--", lw=0.8)
axes[2].plot(r2c, 0, "ro", label=f"Root: {r2c:.8f}")
axes[2].set_title("Exercise 2(c)", fontweight="bold")
axes[2].grid(True, ls=":", alpha=0.6)
axes[2].legend()

plt.tight_layout()
plt.show()
