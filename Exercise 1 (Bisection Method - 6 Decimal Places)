import matplotlib.pyplot as plt
import numpy as np


def bisection(f, a, b, tol=0.5e-6):
    if f(a) * f(b) >= 0:
        raise ValueError("Endpoints must have opposite signs.")
    while (b - a) / 2.0 > tol:
        c = (a + b) / 2.0
        if f(c) == 0:
            return c
        elif f(a) * f(c) < 0:
            b = c
        else:
            a = c
    return (a + b) / 2.0


# Define functions f(x) = 0
f1a = lambda x: x**3 - 9
f1b = lambda x: 3 * x**3 + x**2 - x - 5
f1c = lambda x: np.cos(x) ** 2 + 6 - x

# Solve roots
r1a = bisection(f1a, 2.0, 3.0)
r1b = bisection(f1b, 1.0, 2.0)
r1c = bisection(f1c, 6.0, 7.0)

print("--- EXERCISE 1 RESULTS ---")
print(f"1(a) x^3 = 9              -> Root: {r1a:.6f}")
print(f"1(b) 3x^3 + x^2 = x + 5   -> Root: {r1b:.6f}")
print(f"1(c) cos^2(x) + 6 = x     -> Root: {r1c:.6f}")

# Plotting
fig, axes = plt.subplots(1, 3, figsize=(15, 4.5))

# Plot 1(a)
x = np.linspace(1.5, 3.5, 200)
axes[0].plot(x, f1a(x), "b-", lw=2, label="$f(x) = x^3 - 9$")
axes[0].axhline(0, color="k", ls="--", lw=0.8)
axes[0].plot(r1a, 0, "ro", label=f"Root: {r1a:.6f}")
axes[0].set_title("Exercise 1(a)", fontweight="bold")
axes[0].grid(True, ls=":", alpha=0.6)
axes[0].legend()

# Plot 1(b)
x = np.linspace(0.5, 2.5, 200)
axes[1].plot(x, f1b(x), "b-", lw=2, label="$f(x) = 3x^3 + x^2 - x - 5$")
axes[1].axhline(0, color="k", ls="--", lw=0.8)
axes[1].plot(r1b, 0, "ro", label=f"Root: {r1b:.6f}")
axes[1].set_title("Exercise 1(b)", fontweight="bold")
axes[1].grid(True, ls=":", alpha=0.6)
axes[1].legend()

# Plot 1(c)
x = np.linspace(5.5, 7.5, 200)
axes[2].plot(x, f1c(x), "b-", lw=2, label="$f(x) = \cos^2(x) + 6 - x$")
axes[2].axhline(0, color="k", ls="--", lw=0.8)
axes[2].plot(r1c, 0, "ro", label=f"Root: {r1c:.6f}")
axes[2].set_title("Exercise 1(c)", fontweight="bold")
axes[2].grid(True, ls=":", alpha=0.6)
axes[2].legend()

plt.tight_layout()
plt.show()
