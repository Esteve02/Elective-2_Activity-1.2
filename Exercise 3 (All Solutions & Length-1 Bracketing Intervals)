import matplotlib.pyplot as plt
import numpy as np


def bisection(f, a, b, tol=0.5e-6):
    if f(a) * f(b) >= 0:
        raise ValueError("Endpoints must have opposite signs.")
    while (b - a) / 2.0 > tol:
        c = (a + b) / 2.0
        if f(c) == 0:
            return c
        elif f(a) * f(c) < 0:
            b = c
        else:
            a = c
    return (a + b) / 2.0


# Define functions f(x) = 0
f3a = lambda x: 2 * x**3 - 6 * x - 1
f3b = lambda x: np.exp(x - 2) + x**3 - x
f3c = lambda x: 1 + 5 * x - 6 * x**3 - np.exp(2 * x)

# Roots for 3(a)
r3a_1 = bisection(f3a, -2.0, -1.0)
r3a_2 = bisection(f3a, -1.0, 0.0)
r3a_3 = bisection(f3a, 1.0, 2.0)

# Roots for 3(b)
r3b_1 = bisection(f3b, -2.0, -1.0)
r3b_2 = bisection(f3b, -0.5, 0.5)
r3b_3 = bisection(f3b, 0.5, 1.5)

# Roots for 3(c)
r3c_1 = bisection(f3c, -1.3, -0.3)
r3c_2 = bisection(f3c, -0.5, 0.5)
r3c_3 = bisection(f3c, 0.1, 1.1)

print("--- EXERCISE 3 RESULTS ---")
print(f"3(a) Roots: {r3a_1:.6f}, {r3a_2:.6f}, {r3a_3:.6f}")
print(f"3(b) Roots: {r3b_1:.6f}, {r3b_2:.6f}, {r3b_3:.6f}")
print(f"3(c) Roots: {r3c_1:.6f}, {r3c_2:.6f}, {r3c_3:.6f}")

# Plotting
fig, axes = plt.subplots(1, 3, figsize=(15, 4.5))

# Plot 3(a)
x = np.linspace(-2.5, 2.5, 300)
axes[0].plot(x, f3a(x), "b-", lw=2, label="$f(x) = 2x^3 - 6x - 1$")
axes[0].axhline(0, color="k", ls="--", lw=0.8)
axes[0].plot(
    [r3a_1, r3a_2, r3a_3], [0, 0, 0], "ro", markersize=7, label="Roots"
)
axes[0].set_title("Exercise 3(a)", fontweight="bold")
axes[0].set_ylim(-10, 10)
axes[0].grid(True, ls=":", alpha=0.6)
axes[0].legend()

# Plot 3(b)
x = np.linspace(-2.5, 2.0, 300)
axes[1].plot(x, f3b(x), "b-", lw=2, label="$f(x) = e^{x-2} + x^3 - x$")
axes[1].axhline(0, color="k", ls="--", lw=0.8)
axes[1].plot(
    [r3b_1, r3b_2, r3b_3], [0, 0, 0], "ro", markersize=7, label="Roots"
)
axes[1].set_title("Exercise 3(b)", fontweight="bold")
axes[1].set_ylim(-8, 6)
axes[1].grid(True, ls=":", alpha=0.6)
axes[1].legend()

# Plot 3(c)
x = np.linspace(-1.5, 1.2, 300)
axes[2].plot(x, f3c(x), "b-", lw=2, label="$f(x) = 1 + 5x - 6x^3 - e^{2x}$")
axes[2].axhline(0, color="k", ls="--", lw=0.8)
axes[2].plot(
    [r3c_1, r3c_2, r3c_3], [0, 0, 0], "ro", markersize=7, label="Roots"
)
axes[2].set_title("Exercise 3(c)", fontweight="bold")
axes[2].set_ylim(-10, 10)
axes[2].grid(True, ls=":", alpha=0.6)
axes[2].legend()

plt.tight_layout()
plt.show()
